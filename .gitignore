# Godot 4+ specific ignores
.godot/
/android/

# .NET build output
bin/
obj/
*.user

# IDEs
.idea/
.vs/
*.suo

# OS
.DS_Store
Thumbs.db

# Godot export artifacts
# Godot leaves a .old copy of ProjectRondo.csproj beside it when it rewrites the file; the one a
# re-export committed by accident was byte-identical to the tracked csproj, so what prompted the
# rewrite is not recorded. Either way it is a backup of a tracked file and does not belong here.
*.csproj.old
export.cfg
export_presets.cfg
*.translation

node_modules/
dist/
src-tauri/target/
src-tauri/gen/

# Superpowers scratch (SDD ledgers, briefs, review packages, brainstorm mockups)
# — working files, not artefacts
.superpowers/
